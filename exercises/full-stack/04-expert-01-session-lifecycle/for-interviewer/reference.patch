diff --git a/src/shared/transitions.ts b/src/shared/transitions.ts
index 49f8657..816041c 100644
--- a/src/shared/transitions.ts
+++ b/src/shared/transitions.ts
@@ -13,0 +14,13 @@ export function isTerminal(status: SessionStatus): boolean {
+
+const legalSources: Record<Command, readonly SessionStatus[]> = {
+  start: ["scheduled"],
+  pause: ["live"],
+  resume: ["paused"],
+  end: ["live", "paused"],
+  cancel: ["scheduled", "live", "paused"],
+  reopen: ["ended"],
+};
+
+export function canApply(status: SessionStatus, command: Command): boolean {
+  return legalSources[command].includes(status);
+}
