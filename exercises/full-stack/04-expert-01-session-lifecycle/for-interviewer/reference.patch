diff --git a/test/server/can-apply.test.ts b/test/server/can-apply.test.ts
new file mode 100644
index 0000000..0797aa0
--- /dev/null
+++ b/test/server/can-apply.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from "vitest";
+import {
+  type Command,
+  SESSION_STATUSES,
+  type SessionStatus,
+} from "../../src/shared/sessions";
+import { canApply } from "../../src/shared/transitions";
+
+const baseCommands = [
+  "start",
+  "pause",
+  "resume",
+  "end",
+  "cancel",
+] as const satisfies readonly Command[];
+
+const legalTransitions: Array<[SessionStatus, Command]> = [
+  ["scheduled", "start"],
+  ["scheduled", "cancel"],
+  ["live", "pause"],
+  ["live", "end"],
+  ["live", "cancel"],
+  ["paused", "resume"],
+  ["paused", "end"],
+  ["paused", "cancel"],
+];
+
+const legalKeys = new Set(
+  legalTransitions.map(([status, command]) => `${status}:${command}`),
+);
+
+const cells = SESSION_STATUSES.flatMap((status) =>
+  baseCommands.map((command) => [status, command] as const),
+);
+
+describe("canApply", () => {
+  it.each(cells)("matches the product table for %s → %s", (status, command) => {
+    expect(canApply(status, command)).toBe(
+      legalKeys.has(`${status}:${command}`),
+    );
+  });
+
+  it("allows reopen only from ended", () => {
+    expect(canApply("ended", "reopen")).toBe(true);
+
+    for (const status of SESSION_STATUSES.filter(
+      (sessionStatus) => sessionStatus !== "ended",
+    )) {
+      expect(canApply(status, "reopen")).toBe(false);
+    }
+  });
+});
