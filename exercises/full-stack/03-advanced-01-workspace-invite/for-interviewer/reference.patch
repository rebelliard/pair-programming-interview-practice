+export async function acceptInvitationHandler(
+  dependencies: Dependencies,
+  workspaceId: string,
+  body: unknown,
+): Promise<{ status: number; body: { workspace: Workspace } | ApiError }> {
+  const input = body as { email?: unknown };
+  const email =
+    typeof input.email === "string" ? normalizeEmail(input.email) : "";
+  const workspace = await dependencies.repository.findById(workspaceId);
+
+  if (workspace === undefined) {
+    return {
+      status: 404,
+      body: error("workspace_not_found", "Workspace not found"),
+    };
+  }
+
+  const invitationIndex = workspace.invitations.findIndex(
+    (invitation) => normalizeEmail(invitation.email) === email,
+  );
+  if (invitationIndex === -1) {
+    return {
+      status: 404,
+      body: error("invitation_not_found", "Invitation not found"),
+    };
+  }
+
+  workspace.invitations.splice(invitationIndex, 1);
+  workspace.members.push(email);
+  await dependencies.repository.save(workspace);
+
+  return { status: 200, body: { workspace } };
+}
