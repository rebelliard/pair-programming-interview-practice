new file mode 100644
index 0000000..8162345
--- /dev/null
+++ b/test/client/app.test.tsx
@@ -0,0 +1,39 @@
+import { cleanup, render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, describe, expect, it } from "vitest";
+import { App } from "../../src/client/App";
+import { createApi } from "../../src/client/api";
+import { createInMemoryTransport } from "../fixtures";
+
+afterEach(cleanup);
+
+describe("App", () => {
+  it("invites and accepts a teammate", async () => {
+    const user = userEvent.setup();
+
+    render(<App api={createApi(createInMemoryTransport())} />);
+    await screen.findByRole("cell", { name: "pending@acme.test" });
+
+    await user.type(
+      screen.getByRole("textbox", { name: "Email" }),
+      "new@acme.test",
+    );
+    await user.click(screen.getByRole("button", { name: "Send invite" }));
+
+    expect(
+      await within(
+        screen.getByRole("region", { name: "Invitations" }),
+      ).findByRole("cell", { name: "new@acme.test" }),
+    ).toBeInTheDocument();
+
+    await user.click(
+      screen.getByRole("button", { name: "Accept pending@acme.test" }),
+    );
+    expect(
+      await within(screen.getByRole("region", { name: "Members" })).findByRole(
+        "cell",
+        { name: "pending@acme.test" },
+      ),
+    ).toBeInTheDocument();
+  });
+});
