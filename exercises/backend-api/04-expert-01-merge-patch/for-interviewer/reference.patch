+import type { Profile, RouteHandler } from "./types";
 
 type ProfileRoute = {
   GET: RouteHandler;
   PATCH: RouteHandler;
+  OPTIONS: RouteHandler;
 };
 
+const mergePatchMediaType = "application/merge-patch+json";
+
 function json(body: unknown, status = 200): Response {
   return Response.json(body, { status });
 }
 
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isRecord(patch)) {
+    return structuredClone(patch);
+  }
+
+  const result = isRecord(target) ? structuredClone(target) : {};
+
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      result[key] = mergePatch(result[key], value);
+    }
+  }
+
+  return result;
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+function isProfile(value: unknown): value is Profile {
+  if (!isRecord(value)) {
+    return false;
+  }
+
+  const contact = value.contact;
+  const preferences = value.preferences;
+
+  if (
+    !isRecord(contact) ||
+    !isRecord(preferences) ||
+    !isRecord(contact.address)
+  ) {
+    return false;
+  }
+
+  return (
+    isNonEmptyString(value.id) &&
+    isNonEmptyString(value.displayName) &&
+    isNonEmptyString(contact.email) &&
+    contact.email.includes("@") &&
+    (contact.phone === undefined || typeof contact.phone === "string") &&
+    isNonEmptyString(contact.address.city) &&
+    isNonEmptyString(contact.address.country) &&
+    (preferences.theme === "light" || preferences.theme === "dark") &&
+    typeof preferences.marketingEmail === "boolean" &&
+    Array.isArray(value.tags) &&
+    value.tags.every((tag) => typeof tag === "string")
+  );
+}
+
 export function createProfilesRoute(
   store: ProfileStore = createProfileStore(),
 ): ProfileRoute {
