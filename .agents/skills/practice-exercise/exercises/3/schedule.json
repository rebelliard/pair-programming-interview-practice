{
  "exercise": 3,
  "title": "Webhook retry",
  "surface": "full-stack",
  "kind": "live",
  "difficulty": "advanced",
  "durationMinutes": 50,
  "gates": [
    { "id": "open", "at": "0:00", "kind": "gate", "title": "Open the session" },
    {
      "id": "read",
      "at": "2:00",
      "kind": "gate",
      "title": "Run the tests; read quietly"
    },
    {
      "id": "orientation",
      "at": "7:00",
      "kind": "gate",
      "title": "Explain the delivery path; orientation probes"
    },
    {
      "id": "release-1",
      "at": "10:00",
      "kind": "release",
      "title": "Release 1: reliable delivery"
    },
    {
      "id": "implement",
      "at": "12:00",
      "kind": "gate",
      "title": "Implement the core in tested slices"
    },
    {
      "id": "checkpoint-core",
      "at": "28:00",
      "kind": "checkpoint",
      "title": "Retry is single-flight; coaching pause",
      "expect": "one transport call on double-click, with Retry disabled while pending",
      "verify": "pnpm test"
    },
    {
      "id": "release-2",
      "at": "30:00",
      "kind": "conditional-release",
      "title": "Release 2: bounded retries and Retry-After",
      "requires": "checkpoint-core"
    },
    {
      "id": "handoff",
      "at": "39:00",
      "kind": "gate",
      "title": "Handoff; stop editing"
    },
    {
      "id": "review",
      "at": "42:00",
      "kind": "gate",
      "title": "Self-review; offer grading"
    },
    { "id": "end", "at": "50:00", "kind": "stop", "title": "Time is up" }
  ],
  "rules": [
    {
      "id": "stretch",
      "title": "Optional stretch: already delivered",
      "before": "36:00",
      "requires": "release-2"
    }
  ]
}
