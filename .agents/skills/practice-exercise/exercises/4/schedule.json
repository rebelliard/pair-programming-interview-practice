{
  "exercise": 4,
  "title": "Session lifecycle",
  "surface": "full-stack",
  "kind": "live",
  "difficulty": "expert",
  "durationMinutes": 50,
  "gates": [
    { "id": "open", "at": "0:00", "kind": "gate", "title": "Open the session" },
    {
      "id": "read",
      "at": "2:00",
      "kind": "gate",
      "title": "Run the tests; read quietly"
    },
    {
      "id": "orientation",
      "at": "7:00",
      "kind": "gate",
      "title": "Draw the transition table; orientation probes"
    },
    {
      "id": "release-1",
      "at": "10:00",
      "kind": "release",
      "title": "Release 1: resume from a stale tab"
    },
    {
      "id": "implement",
      "at": "12:00",
      "kind": "gate",
      "title": "Pin the row, flip the wrong cells, make the minimal fix"
    },
    {
      "id": "checkpoint-core",
      "at": "28:00",
      "kind": "checkpoint",
      "title": "Resume is legal only from paused; coaching pause",
      "expect": "client and server allow Resume only from paused, with the two wrong cells red then green",
      "verify": "pnpm test"
    },
    {
      "id": "release-2",
      "at": "30:00",
      "kind": "conditional-release",
      "title": "Release 2: shared legality and stale-tab recovery",
      "requires": "checkpoint-core"
    },
    {
      "id": "handoff",
      "at": "39:00",
      "kind": "gate",
      "title": "Handoff; stop editing"
    },
    {
      "id": "review",
      "at": "42:00",
      "kind": "gate",
      "title": "Self-review; offer grading"
    },
    { "id": "end", "at": "50:00", "kind": "stop", "title": "Time is up" }
  ],
  "rules": [
    {
      "id": "stretch",
      "title": "Optional stretch: reopen",
      "before": "36:00",
      "requires": "release-2"
    }
  ]
}
